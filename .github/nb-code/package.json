{
  "name": "nb-code-mvp1",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Pipeline MVP1 local do NB-Code",
  "scripts": {
    "pipeline:sample": "node --experimental-strip-types ./scripts/mvp1-pipeline.ts --request ./examples/request.sample.json --output ./examples/response.sample.json",
    "pipeline:test-negative": "node --experimental-strip-types ./scripts/mvp1-negative-test.ts",
    "pipeline:test-regression": "node --experimental-strip-types ./scripts/mvp1-regression-test.ts",
    "pipeline:test-ci-report": "node --experimental-strip-types ./scripts/mvp1-ci-report-test.ts",
    "pipeline:test-validate-only": "node --experimental-strip-types ./scripts/mvp1-validate-only-test.ts",
    "pipeline:test-ndjson": "node --experimental-strip-types ./scripts/mvp1-ndjson-test.ts",
    "pipeline:test-fail-on-status": "node --experimental-strip-types ./scripts/mvp1-fail-on-status-test.ts",
    "pipeline:test-release-check": "node --experimental-strip-types ./scripts/mvp1-release-check-test.ts",
    "pipeline:test": "npm run pipeline:test-negative && npm run pipeline:test-regression && npm run pipeline:test-ci-report && npm run pipeline:test-validate-only && npm run pipeline:test-ndjson && npm run pipeline:test-fail-on-status && npm run pipeline:test-release-check",
