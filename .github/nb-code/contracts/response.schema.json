{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nb-code.local/schemas/response.schema.json",
  "title": "NB-Code Agent Response",
  "description": "Contrato minimo de saida para o fluxo MVP1 do agente NB-Code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "status",
    "summary",
    "actions",
    "validations",
    "security"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "needs-input"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1500
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target",
          "description"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "edit",
              "create",
              "run-command",
              "analysis"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "description": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "result"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "result": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped"
            ]
          },
          "details": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "default": []
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secretsExposed",
        "sensitiveAreaTouched",
        "notes"
      ],
      "properties": {
        "secretsExposed": {
          "type": "boolean"
        },
        "sensitiveAreaTouched": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "default": ""
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      },
      "default": []
    }
  }
}
